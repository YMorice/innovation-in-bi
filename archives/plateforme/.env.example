# À copier en .env.local pour le développement, et à déclarer dans
# Vercel → Settings → Environment Variables pour la production.

# Supabase → Project Settings → API (valeurs SUPABASE_URL et SUPABASE_ANON_PUBLIC_KEY du .env du projet)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (valeur SUPABASE_SECRET_KEY du .env du projet).
# Serveur uniquement : ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
